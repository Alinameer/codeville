#!/usr/bin/env bash
# Launch the Codeville panel applet.
#
# Strips snap environment variables first. When a terminal is running inside a
# snap (the VS Code snap, for example) it exports an LD_LIBRARY_PATH and
# GTK_PATH pointing at the snap's own libraries, and the system python3 then
# dies with:
#     symbol lookup error: .../libpthread.so.0: undefined symbol:
#     __libc_pthread_init, version GLIBC_PRIVATE
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec env -u LD_LIBRARY_PATH -u GTK_PATH -u GIO_MODULE_DIR -u GDK_PIXBUF_MODULE_FILE \
         -u SNAP -u SNAP_NAME -u SNAP_REVISION -u LOCPATH \
     python3 "$HERE/shell/codeville_tray.py" "$@"
